    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_events",
        "name": "equipment_event_kind",
        "value": "\"kind\" IN ('register','adopt','issue','return','reassign','edit','repair','repaired','lost','recover','dispose')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_events",
        "name": "equipment_event_reference",
        "value": "length(trim(\"reference\")) > 0 AND length(trim(\"reason\")) > 0",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_events",
