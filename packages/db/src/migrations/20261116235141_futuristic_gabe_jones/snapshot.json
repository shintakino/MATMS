      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_units",
        "name": "equipment_version",
        "value": "\"version\" >= 0",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_units",
        "name": "equipment_state",
        "value": "\"state\" IN ('available','issued','under_repair','lost','disposed')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_units",
        "name": "equipment_person",
        "value": "(\"person_id\" IS NULL) = (\"person_name\" IS NULL) AND (\"state\" <> 'issued' OR \"person_id\" IS NOT NULL) AND (\"state\" NOT IN ('available','disposed') OR \"person_id\" IS NULL)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_units",
        "name": "equipment_identity",
        "value": "length(trim(\"permanent_number\")) > 0 AND \"normalized_number\" = upper(trim(\"permanent_number\")) AND length(trim(\"brand\")) > 0 AND \"normalized_brand\" = upper(trim(\"brand\")) AND length(trim(\"model\")) > 0",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "custodial_equipment_units",
        "name": "equipment_serial",
        "value": "(\"serial_number\" IS NOT NULL AND length(trim(\"serial_number\")) > 0 AND \"normalized_serial\" IS NOT NULL AND \"normalized_serial\" = upper(trim(\"serial_number\")) AND \"missing_serial_reason\" IS NULL) OR (\"serial_number\" IS NULL AND \"normalized_serial\" IS NULL AND \"missing_serial_reason\" IS NOT NULL AND length(trim(\"missing_serial_reason\")) > 0)",
        "entityType": "checks"
      }
    }
