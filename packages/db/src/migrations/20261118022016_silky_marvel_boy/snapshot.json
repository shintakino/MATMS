        "schema": "public",
        "table": "custodial_equipment_serial_reservations",
        "name": "equipment_serial_reservation_normalized",
        "value": "length(trim(\"normalized_brand\")) > 0 AND \"normalized_brand\" = upper(trim(\"normalized_brand\")) AND length(trim(\"normalized_serial\")) > 0 AND \"normalized_serial\" = upper(trim(\"normalized_serial\"))",
        "entityType": "checks"
      }
    },
