      "row": {
        "schema": "public",
        "table": "custodial_equipment_events",
        "name": "equipment_issue_correction",
        "value": "(\"kind\" = 'correct_issue') = (\"corrected_issue_id\" IS NOT NULL AND \"issue_details\" IS NOT NULL) AND (\"kind\" = 'correct_issue' OR (\"corrected_issue_id\" IS NULL AND \"issue_details\" IS NULL)) AND (\"kind\" <> 'correct_issue' OR \"transaction_id\" IS NULL)",
