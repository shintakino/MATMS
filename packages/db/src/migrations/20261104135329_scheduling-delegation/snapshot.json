    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "leave_bookings",
        "name": "leave_booking_beneficiary_name",
        "value": "length(trim(\"person_name\")) > 0",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "resource_bookings",
        "name": "resource_booking_origin",
