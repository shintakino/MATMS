    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "resource_bookings",
        "name": "resource_booking_beneficiary_category",
        "value": "\"beneficiary_category\" IN ('teacher', 'shs', 'jhs', 'personnel', 'student', 'other')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "scheduling_invitations",
        "name": "scheduling_invitation_kind",
        "value": "(\"kind\" = 'leave' AND \"person_id\" IS NOT NULL AND \"person_version\" IS NOT NULL) OR (\"kind\" = 'resource' AND \"person_id\" IS NULL AND \"person_version\" IS NULL)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "scheduling_invitations",
        "name": "scheduling_invitation_expiry",
        "value": "\"expires_at\" > \"created_at\" AND \"expires_at\" <= \"created_at\" + interval '7 days'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "scheduling_invitations",
        "name": "scheduling_invitation_hash",
        "value": "\"token_hash\" ~ '^[0-9a-f]{64}$'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "scheduling_invitations",
        "name": "scheduling_invitation_receipt",
        "value": "num_nonnulls(\"used_at\", \"used_operation_id\", \"used_fingerprint\", \"receipt_code\") IN (0, 4)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
